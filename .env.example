# Copie para .env.local e preencha.
# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<publishable/anon key>
# URL pública da aplicação (usada no redirect do OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Apenas para seed e testes (NUNCA usar no código do navegador; não configurar na Vercel) ---
# Connection string Postgres (Project Settings > Database). Para o seed, use a conexão direta/session pooler.
DATABASE_URL=postgresql://postgres:<senha>@db.<project-ref>.supabase.co:5432/postgres
# Necessário apenas para os testes de integração locais (cria usuários de teste)
SUPABASE_SECRET_KEY=

# Login de desenvolvimento por e-mail/senha — ignorado fora de NODE_ENV=development
DEV_EMAIL_LOGIN=false
